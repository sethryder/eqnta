# PHP here is only the offline PEQ → JSON pipeline (php artisan eq:*). See README.
APP_NAME=eqnta
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=single
LOG_LEVEL=debug

# No web runtime: keep every store off the database so `php artisan` never needs app tables.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# The MariaDB that eq:import-peq loads the PEQ dump into (started by compose.yaml). Defaults match
# config/database.php's `peq` connection and compose.yaml, so these can stay commented out.
DB_CONNECTION=peq
# PEQ_DB_HOST=127.0.0.1
# PEQ_DB_PORT=3306
# PEQ_DB_DATABASE=peq
# PEQ_DB_USERNAME=root
# PEQ_DB_PASSWORD=
